# 1. BANCO DE DADOS (PostgreSQL)
# Local: postgresql://usuario:senha@localhost:5432/unidesapego
# Render: cole aqui a "Internal Database URL" ou "External Database URL" do Render Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/unidesapego"

# 2. SERVIDOR (API no Render / Local)
PORT=5000
JWT_SECRET="unidesapego_unifor_super_secret_jwt_key_2026"

# 3. FRONT-END (Vercel / Local)
# No ambiente local: http://localhost:5000
# Na Vercel (Production): URL do seu Web Service no Render (ex: https://unidesapego-api.onrender.com)
VITE_API_URL="http://localhost:5000"
